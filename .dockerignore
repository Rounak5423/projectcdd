# Version control
.git/
.gitignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python caches and virtualenvs
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
genesis-engine/backend/venv/
genesis-engine/backend/.venv/
genesis-engine/backend/__pycache__/
