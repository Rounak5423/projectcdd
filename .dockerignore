# Databases and WAL state
*.db
*.db-wal
*.db-shm
*.sqlite
genesis-engine/backend/db/*.db
genesis-engine/backend/db/*.db-wal
genesis-engine/backend/db/*.db-shm

# Datasets and training artifacts
datasets/
ml/data/
ml/runs/
genesis-engine/backend/ml/data/
genesis-engine/backend/ml/runs/

# Documentation
docs/

# Secrets and local environments
.env
.env.*
!.env.example
genesis-engine/backend/.env

# Build outputs and temporary files
dist/
build/
test-results/
coverage/
.DS_Store
*.log
