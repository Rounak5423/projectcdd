# ==============================================================================
# GENESIS Civilisation Engine — Production Environment Configuration Template
# Copy this file to .env and configure all variables prior to deployment:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# - In production (ENVIRONMENT=production), the backend will REFUSE to start if
#   GENESIS_JWT_SECRET or ADMIN_DEFAULT_PASSWORD use default/placeholder values.
# - Generate a secure 64-char JWT secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ==============================================================================

# Application Environment ('production' | 'development' | 'staging')
ENVIRONMENT=production

# Network & Host Binding
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
FRONTEND_DEV_PORT=5173
LOG_LEVEL=INFO

# Persistent SQLite WAL Database Path
# Inside Docker containers, this is mapped to the local named volume at /app/db/genesis.db
GENESIS_DB_PATH=/app/db/genesis.db

# Authentication Security (Minimum 32 random characters in production)
# Must NOT be 'genesis_super_secret_jwt_key_2026_dev' in production
GENESIS_JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_HOURS=24

# Seeded Credentials (Required in production: do NOT use 'AdminPassword123!')
ADMIN_DEFAULT_PASSWORD=replace_with_a_secure_custom_admin_password_in_production
USER_DEFAULT_PASSWORD=replace_with_a_secure_custom_player_password_in_production
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=60

# Simulation Core Engine Rules
DAYS_PER_TICK=1
DAYS_PER_YEAR=365
AUTOSAVE_INTERVAL_TICKS=50

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of exact allowed origins; wildcard '*' is strictly prohibited in production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Concurrency
AUTH_RATE_LIMIT_PER_MINUTE=30
MAX_WS_CONNECTIONS_PER_WORLD=250
MAX_WS_TOTAL_CONNECTIONS=1000
MAX_AI_CONCURRENCY=6
MAX_AI_QUEUE_DEPTH=32

# Machine Learning & Simulation Science Flags
ML_ENABLED=false
TELEMETRY_ENABLED=false
TELEMETRY_INTERVAL_TICKS=1
AI_CONTROLLER_KILL_SWITCH=false

# External AI Advisor Provider Keys (Optional: Falls back to local deterministic advisors)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend Runtime URL Overrides (Optional; leave empty for same-origin reverse proxy)
VITE_API_URL=
VITE_WS_URL=
