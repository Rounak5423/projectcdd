# ==============================================================================
# CIVORA — Production Environment Configuration Template
# Copy this file to .env and configure all variables prior to deployment.
# Never commit real secrets or production .env files to version control!
# ==============================================================================

# Application Environment ('development' | 'staging' | 'production')
ENVIRONMENT=production

# Backend Host & Port
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Persistent Database File Path (Ensure directory resides on a persistent disk)
GENESIS_DB_PATH=genesis-engine/backend/db/genesis.db

# Authentication Security (Minimum 32 random characters in production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
GENESIS_JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_HOURS=24

# CORS Allowed Origins (Comma-separated exact origins; no wildcards in production)
ALLOWED_ORIGINS=https://civora.example.com,https://api.civora.example.com

# Rate Limiting (Per IP auth attempts per minute)
AUTH_RATE_LIMIT_PER_MINUTE=30

# Real-Time Gateway & Capacity
MAX_WS_CONNECTIONS_PER_WORLD=250
MAX_WS_TOTAL_CONNECTIONS=1000
MAX_AI_CONCURRENCY=6
MAX_AI_QUEUE_DEPTH=32

# External AI Provider Keys (Optional: Falls back to built-in simulation advisors)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend Build Time Settings (Prefix with VITE_)
# If served from the same domain/reverse proxy, leave empty for relative paths
VITE_API_URL=
VITE_WS_URL=
