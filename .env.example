# Copy this file to ".env" to change settings. All lines are optional.
GENESIS_DB=data/genesis.db
GENESIS_SEED=42
GENESIS_AUTOSAVE_DAYS=5
# Offline progression is OFF by default: the world is frozen while GENESIS is closed.
# Set to "on" to let days pass while you are away (it is announced in the timeline and Help).
GENESIS_OFFLINE_PROGRESSION=off
GENESIS_OFFLINE_DAYS_PER_HOUR=2
GENESIS_OFFLINE_MAX_DAYS=30
