{
  "$schema": "https://civora.engine/schemas/council-assets-v1.json",
  "version": "1.0.0",
  "description": "Asset manifest and GLB fallback specifications for CIVORA 3D Royal Council Chamber",
  "assets": {
    "chamber": {
      "path": "/models/council/chamber_environment.glb",
